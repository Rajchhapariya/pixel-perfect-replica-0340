# Apex Detail Works — Supabase Environment Variables
# These are automatically injected by Lovable when you connect Supabase.
# If running locally, copy this to .env and fill in your values from:
# https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
